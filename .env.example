NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=

# msnodesqlv8 için ODBC bağlantı dizesi (ConnectionPool { connectionString } ile kullanılır)
MSSQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=(localdb)\MSSQLLocalDB;Database=toptanciProj;Trusted_Connection=Yes;Encrypt=No;

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=toptanci-projesi

# Misafir ürün kataloğu (varsayılan: açık)
PUBLIC_CATALOG_ENABLED=true
# Pazarlama izni üyelik şartı olsun mu? (varsayılan: hayır)
REQUIRE_COMMERCIAL_CONSENT=false

# Site iletişim (placeholder — gerçek bilgilerle doldurun)
SITE_ADDRESS=
SITE_PHONE=
SITE_EMAIL=
SITE_FACEBOOK=
SITE_INSTAGRAM=
SITE_WHATSAPP=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
